# Copy to .env and fill in, then: docker compose -f docker-compose.prod.yml up -d --build

# Public domain pointing at the VM's IP (e.g. via DuckDNS or your own domain).
# Caddy requests a Let's Encrypt certificate for this automatically.
DOMAIN=

# Any strong random string, e.g. `openssl rand -base64 33`
AUTH_SECRET=

# Google OAuth client (console.cloud.google.com/apis/credentials).
# Authorized redirect URI: https://<DOMAIN>/api/auth/callback/google
GOOGLE_CLIENT_ID=
AUTH_GOOGLE_SECRET=

# PostgreSQL password (any strong random string)
DB_PASSWORD=
