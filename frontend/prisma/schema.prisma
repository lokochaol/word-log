generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum BlockType {
  TEXT
  CODE
  MERMAID
  IMAGE
}

enum QuickNoteSource {
  SCRATCH
  VOICE
}

enum QuickNoteStatus {
  ACTIVE
  ARCHIVED
}

enum LinkTargetType {
  PERMANENT_NOTE
  INDEX_ENTRY
}

enum DiscoveryKind {
  NEWS
  LITERATURE
}

enum DiscoveryStatus {
  CANDIDATE
  CONFIRMED
}

/// A temporary, quickly-captured note ("走り書き"). Either typed on the spot
/// (SCRATCH) or, in a future phase, transcribed from a voice memo (VOICE — the
/// voice* columns are a schema hook only, not wired up in Phase 1). Active
/// notes live on the /scratch timeline; once promoted into one or more
/// PermanentNotes they flip to ARCHIVED and disappear from that timeline.
model QuickNote {
  id       String          @id @default(uuid())
  ownerSub String          @map("owner_sub")
  source   QuickNoteSource @default(SCRATCH)
  status   QuickNoteStatus @default(ACTIVE)

  literatureMemoId String?         @map("literature_memo_id")
  literatureMemo   LiteratureMemo? @relation(fields: [literatureMemoId], references: [id], onDelete: SetNull)

  // Phase 2 hooks — not populated by any Phase 1 code path.
  voiceAudioUrl        String? @map("voice_audio_url")
  voiceTranscript       String? @map("voice_transcript")
  voiceDurationSeconds  Int?    @map("voice_duration_seconds")

  encounteredAt DateTime @default(now()) @map("encountered_at")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  blocks               QuickNoteBlock[]
  promotionSourceLinks PromotionSourceQuickNote[]
  discoveryCandidates  DiscoveryCandidate[]

  @@index([ownerSub, status, encounteredAt])
  @@index([literatureMemoId])
  @@map("quick_note")
}

model QuickNoteBlock {
  id          String    @id @default(uuid())
  quickNoteId String    @map("quick_note_id")
  quickNote   QuickNote @relation(fields: [quickNoteId], references: [id], onDelete: Cascade)
  position    Int
  type        BlockType @map("block_type")
  content     String
  language    String?
  caption     String?

  @@index([quickNoteId, position])
  @@map("quick_note_block")
}

/// A permanent note ("ツェッテルカステン" card). Lives in one strict,
/// owner-wide order (orderKey, fractional indexing — see src/lib/rank.ts) and
/// is only ever created through the promotion workflow (src/lib/promotion.ts)
/// — there is no direct `create`.
model PermanentNote {
  id       String @id @default(uuid())
  ownerSub String @map("owner_sub")
  title    String
  orderKey String @map("order_key")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  blocks               PermanentNoteBlock[]
  outboundLinks        PermanentNoteLink[]             @relation("LinkSource")
  inboundLinks         PermanentNoteLink[]             @relation("LinkTargetNote")
  indexEntries         IndexEntry[]
  promotionOutputLinks PromotionOutputPermanentNote[]
  literatureMemos      PermanentNoteLiteratureMemo[]

  @@unique([ownerSub, orderKey])
  @@index([ownerSub, orderKey])
  @@map("permanent_note")
}

/// A PermanentNote can carry several 文献メモ — e.g. when several selected
/// 走り書き, each citing a different source, are merged into one permanent
/// note, all of their distinct literature links carry over. (QuickNote stays
/// single-literature-memo — this many-to-many is PermanentNote-only.)
model PermanentNoteLiteratureMemo {
  id               String         @id @default(uuid())
  permanentNoteId  String         @map("permanent_note_id")
  permanentNote    PermanentNote  @relation(fields: [permanentNoteId], references: [id], onDelete: Cascade)
  literatureMemoId String         @map("literature_memo_id")
  literatureMemo   LiteratureMemo @relation(fields: [literatureMemoId], references: [id], onDelete: Cascade)
  createdAt        DateTime       @default(now()) @map("created_at")

  @@unique([permanentNoteId, literatureMemoId])
  @@index([literatureMemoId])
  @@map("permanent_note_literature_memo")
}

model PermanentNoteBlock {
  id              String        @id @default(uuid())
  permanentNoteId String        @map("permanent_note_id")
  permanentNote   PermanentNote @relation(fields: [permanentNoteId], references: [id], onDelete: Cascade)
  position        Int
  type            BlockType     @map("block_type")
  content         String
  language        String?
  caption         String?

  @@index([permanentNoteId, position])
  @@map("permanent_note_block")
}

/// A link from a PermanentNote to either another PermanentNote or an
/// IndexEntry. `relationLabel` (e.g. "応用元") is the primary display text —
/// the target's title/keyword is a secondary annotation.
model PermanentNoteLink {
  id                 String         @id @default(uuid())
  sourceNoteId       String         @map("source_note_id")
  sourceNote         PermanentNote  @relation("LinkSource", fields: [sourceNoteId], references: [id], onDelete: Cascade)
  targetType         LinkTargetType @map("target_type")
  targetNoteId       String?        @map("target_note_id")
  targetNote         PermanentNote? @relation("LinkTargetNote", fields: [targetNoteId], references: [id], onDelete: Cascade)
  targetIndexEntryId String?        @map("target_index_entry_id")
  targetIndexEntry   IndexEntry?    @relation(fields: [targetIndexEntryId], references: [id], onDelete: Cascade)
  relationLabel      String         @map("relation_label")
  createdAt          DateTime       @default(now()) @map("created_at")

  @@index([sourceNoteId])
  @@index([targetNoteId])
  @@index([targetIndexEntryId])
  @@map("permanent_note_link")
}

/// A curated, owner-unique keyword pointing at one PermanentNote — the
/// entry point into the Zettelkasten's global order. Keeping the index small
/// and deliberate is a UX goal, not just a schema constraint.
model IndexEntry {
  id        String        @id @default(uuid())
  ownerSub  String        @map("owner_sub")
  keyword   String
  noteId    String        @map("note_id")
  note      PermanentNote @relation(fields: [noteId], references: [id], onDelete: Cascade)
  createdAt DateTime      @default(now()) @map("created_at")

  links PermanentNoteLink[]

  @@unique([ownerSub, keyword])
  @@index([ownerSub])
  @@map("index_entry")
}

/// One promotion transaction: a set of QuickNotes archived together to
/// produce a set of new PermanentNotes. Kept purely for history/audit —
/// Phase 1 only reads it via listBatchHistory.
model PromotionBatch {
  id        String   @id @default(uuid())
  ownerSub  String   @map("owner_sub")
  createdAt DateTime @default(now()) @map("created_at")

  sourceQuickNotes     PromotionSourceQuickNote[]
  outputPermanentNotes PromotionOutputPermanentNote[]

  @@index([ownerSub, createdAt])
  @@map("promotion_batch")
}

model PromotionSourceQuickNote {
  id          String         @id @default(uuid())
  batchId     String         @map("batch_id")
  batch       PromotionBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  quickNoteId String         @map("quick_note_id")
  quickNote   QuickNote      @relation(fields: [quickNoteId], references: [id], onDelete: Cascade)

  @@unique([batchId, quickNoteId])
  @@index([quickNoteId])
  @@map("promotion_source_quick_note")
}

model PromotionOutputPermanentNote {
  id              String         @id @default(uuid())
  batchId         String         @map("batch_id")
  batch           PromotionBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  permanentNoteId String         @map("permanent_note_id")
  permanentNote   PermanentNote  @relation(fields: [permanentNoteId], references: [id], onDelete: Cascade)

  @@unique([batchId, permanentNoteId])
  @@index([permanentNoteId])
  @@map("promotion_output_permanent_note")
}

/// A shared 文献メモ (literature memo) — citation info + an "in my own words"
/// summary for something read. 1:1 with a specific Zotero library item per
/// owner (deduped by ownerSub+zoteroKey — see @@unique below); manually
/// entered memos (zoteroKey null, e.g. Zotero not configured) skip dedup
/// entirely since Postgres treats each NULL as distinct. Referenced by many
/// QuickNotes and many PermanentNotes (many-to-one from each side).
model LiteratureMemo {
  id        String   @id @default(uuid())
  ownerSub  String   @map("owner_sub")
  zoteroKey String?  @map("zotero_key")
  citation  String
  url       String?
  summary   String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  quickNotes          QuickNote[]
  permanentNoteLinks  PermanentNoteLiteratureMemo[]
  discoveryCandidates DiscoveryCandidate[]

  @@unique([ownerSub, zoteroKey])
  @@index([ownerSub])
  @@map("literature_memo")
}

/// An AI-surfaced "might be related" suggestion (a news article or a piece
/// of literature) attached to one QuickNote — populated by the twice-daily
/// discovery batch (src/lib/discovery.ts, wired to run at 7:00/19:00 via
/// vercel.json's cron + src/app/api/cron/discovery). The app never judges
/// relevance itself: a candidate starts as CANDIDATE and only flips to
/// CONFIRMED when the owner acts on it — adding it as a literature memo, or
/// writing a new QuickNote from it. There is no separate "mark relevant"
/// action. `literatureMemoId` is set once the candidate has been turned into
/// (or matched to) a LiteratureMemo — see resolveLiteratureForCandidate's
/// URL-keyed find-or-create in src/lib/discovery.ts, which is how the same
/// article surfacing twice never creates two literature memos.
model DiscoveryCandidate {
  id          String          @id @default(uuid())
  ownerSub    String          @map("owner_sub")
  quickNoteId String          @map("quick_note_id")
  quickNote   QuickNote       @relation(fields: [quickNoteId], references: [id], onDelete: Cascade)
  kind        DiscoveryKind
  status      DiscoveryStatus @default(CANDIDATE)
  title       String
  summary     String
  sourceLabel String          @map("source_label")
  url         String?
  confidence  Int

  literatureMemoId String?         @map("literature_memo_id")
  literatureMemo   LiteratureMemo? @relation(fields: [literatureMemoId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now()) @map("created_at")

  @@index([quickNoteId])
  @@index([ownerSub, status])
  @@map("discovery_candidate")
}

/// Per-user Zotero Web API credentials (this is a multi-tenant app — each
/// owner links their own Zotero library, never a single app-wide account).
/// apiKeyEncrypted holds AES-256-GCM ciphertext (see src/lib/crypto.ts),
/// never the plaintext key.
model ZoteroCredential {
  id              String   @id @default(uuid())
  ownerSub        String   @unique @map("owner_sub")
  apiKeyEncrypted String   @map("api_key_encrypted")
  libraryId       String   @map("library_id")
  libraryType     String   @default("user") @map("library_type")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@map("zotero_credential")
}
